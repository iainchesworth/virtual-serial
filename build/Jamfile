# The library is header-only: there is no compilation unit.  Declaring the
# target with <build>no keeps `b2` from trying to compile or link anything
# while still letting boost-install perform the header installation when
# the library is built as part of a Boost release.

import ../../config/checks/config : requires ;

lib boost_virtual_serial : : <build>no ;

boost-install boost_virtual_serial ;
