#!/bin/sh
#
# Rejects commit messages that carry attribution trailers, "generated by/with"
# statements, robot markers or tool attribution.
#
# Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Bypass is deliberately not documented; the CI job checks the same rules.

set -eu

root=$(git rev-parse --show-toplevel)

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/tools/check_commit_message.py" "$1"
fi

if command -v python >/dev/null 2>&1; then
    exec python "$root/tools/check_commit_message.py" "$1"
fi

echo "commit-msg: no python interpreter found" >&2
exit 1
